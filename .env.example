# ==============================================================================
# Application Configuration & Secrets Template
# COPY THIS FILE TO .env AND POPULATE WITH REAL CREDENTIALS. DO NOT COMMIT .env!
# ==============================================================================

# Application Environment
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
STREAMLIT_SERVER_PORT=8501

# Database Configuration (MySQL 8.0)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/mm_chatbot_rag

# Optional Fallback SQLite for offline sandboxed development/tests:
# If MySQL is unreachable and ALLOW_SQLITE_FALLBACK=true, SQLite will be used.
ALLOW_SQLITE_FALLBACK=true
SQLITE_DB_PATH=sqlite:///./mm_chatbot_rag.db

# Provider Configuration: "mock" (offline testing, no API key), "openai", or "gemini"
PROVIDER_MODE=mock

# External Provider Credentials (Required only when PROVIDER_MODE is not "mock")
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-1.5-flash

# Media Upload Limits (MB)
MAX_IMAGE_SIZE_MB=10
MAX_AUDIO_SIZE_MB=25

# RAG Hyperparameters
RAG_SIMILARITY_THRESHOLD=0.60
RAG_TOP_K=3

# Emotional Support Guardrails
ENABLE_CRISIS_GUARDRAIL=true
